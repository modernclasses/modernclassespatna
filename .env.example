# Modern Classes Patna - Environment Configuration Template
# Copy this file to .env and fill in your real credentials.
# NEVER commit the real .env file to Git!

# Environment mode: development, staging, production
APP_ENV=development

# Supabase Backend Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Google Play Billing Product IDs (Configured in Google Play Console)
PLAY_PRODUCT_BPSC_SPECIAL=course_bpsc_71st_special
PLAY_PRODUCT_BSSC_CRASH=course_bssc_cgl_crash
PLAY_PRODUCT_RAILWAY_NTPC=course_railway_ntpc_target

# Support & Institute Contact
INSTITUTE_NAME=Modern Classes Patna
INSTITUTE_SUPPORT_EMAIL=support@modernclassespatna.com
INSTITUTE_SUPPORT_PHONE=+919876543210
